[Unit]
Description=Cryptix web (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_PATH__
EnvironmentFile=__APP_PATH__/.env.production
Environment=HOME=__APP_PATH__
ExecStart=/usr/bin/npm run start -- -p ${PORT}
Restart=always
RestartSec=3
# Long-lived SSE streams keep `next start` alive after SIGTERM; cap the stop so a
# deploy swap takes seconds (clients reconnect automatically), not the 90 s default.
TimeoutStopSec=8
KillMode=mixed
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=__APP_PATH__

[Install]
WantedBy=multi-user.target
